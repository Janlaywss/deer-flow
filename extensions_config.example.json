{
  "mcpInterceptors": [],
  "mcpServers": {
    "knowledgebase": {
      "enabled": true,
      "type": "stdio",
      "command": "sh",
      "args": [
        "-lc",
        "exec uvx --from \"${MCP_KNOWLEDGEBASE_SERVER_PATH:-../mcp_servers/mcp_server_knowledgebase}\" mcp-server-knowledgebase"
      ],
      "env": {
        "MCP_KNOWLEDGEBASE_SERVER_PATH": "$MCP_KNOWLEDGEBASE_SERVER_PATH",
        "VOLCENGINE_ACCESS_KEY": "$VOLCENGINE_ACCESS_KEY",
        "VOLCENGINE_SECRET_KEY": "$VOLCENGINE_SECRET_KEY",
        "VOLCENGINE_ACCESS_KEY_ID": "$VOLCENGINE_ACCESS_KEY_ID",
        "VOLCENGINE_SECRET_ACCESS_KEY": "$VOLCENGINE_SECRET_ACCESS_KEY",
        "VIKINGDB_ACCESS_KEY_ID": "$VIKINGDB_ACCESS_KEY_ID",
        "VIKINGDB_SECRET_ACCESS_KEY": "$VIKINGDB_SECRET_ACCESS_KEY",
        "KNOWLEDGE_BASE_PROJECT": "$KNOWLEDGE_BASE_PROJECT",
        "VIKINGDB_PROJECT": "$VIKINGDB_PROJECT",
        "KNOWLEDGE_BASE_REGION": "$KNOWLEDGE_BASE_REGION"
      },
      "description": "Volcengine Viking Knowledge Base MCP server"
    },
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access"
    }
  },
  "skills": {
    "chart-visualization": {
      "enabled": false
    },
    "claude-to-deerflow": {
      "enabled": false
    },
    "code-documentation": {
      "enabled": false
    },
    "data-analysis": {
      "enabled": false
    },
    "find-skills": {
      "enabled": false
    },
    "frontend-design": {
      "enabled": false
    },
    "github-deep-research": {
      "enabled": false
    },
    "image-generation": {
      "enabled": false
    },
    "newsletter-generation": {
      "enabled": false
    },
    "podcast-generation": {
      "enabled": false
    },
    "ppt-generation": {
      "enabled": false
    },
    "skill-creator": {
      "enabled": false
    },
    "surprise-me": {
      "enabled": false
    },
    "systematic-literature-review": {
      "enabled": false
    },
    "vercel-deploy": {
      "enabled": false
    },
    "video-generation": {
      "enabled": false
    },
    "web-design-guidelines": {
      "enabled": false
    }
  }
}
